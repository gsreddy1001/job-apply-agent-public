# ---------------------------------------------------------------------------
# Copy this file to .env and fill in YOUR OWN keys. Never commit .env.
# This repo ships no keys: create each one in your own account at the links below.
# ---------------------------------------------------------------------------

# Apify: runs the job-board scrapers (required)
#   1. Sign up at https://apify.com (the free plan includes about $5/month of usage)
#   2. Open https://console.apify.com/settings/integrations
#   3. Copy your "Personal API token" (it starts with apify_api_)
APIFY_TOKEN=

# OpenRouter: the LLM used to score jobs and tailor resumes (required)
#   1. Sign up at https://openrouter.ai
#   2. Create a key at https://openrouter.ai/keys (it starts with sk-or-v1-)
#   3. Paid models need credit: https://openrouter.ai/settings/credits
#      With $0 credit, only ":free" models work (about 50 requests/day).
OPENROUTER_API_KEY=

# Optional: which model to use (default anthropic/claude-sonnet-5.5).
#   Browse models at https://openrouter.ai/models. A free option looks like
#   nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MODEL=

# Optional: file name for each tailored resume (Google Doc + PDF)
RESUME_TITLE=Your Name | Resume

# Optional: pin the tracker Google Sheet by ID (the long ID in the Sheet's URL);
#   otherwise the Sheet is found or created by name in Drive folder "Job Applications"
SHEET_ID=

# Optional: Telegram alert when the daily Modal run fails
#   1. In Telegram, message @BotFather, send /newbot, and copy the bot token
#   2. Send your new bot any message, then open
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and copy "chat":{"id": ...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Not stored in this file:
#
# Google Drive / Docs / Sheets (via the Google Workspace CLI "gws")
#   1. Create a project at https://console.cloud.google.com
#   2. Enable the Google Drive, Docs, and Sheets APIs (APIs & Services > Library)
#   3. Set up the OAuth consent screen (Google Auth Platform) and add yourself as a test user
#   4. Create an OAuth client ID of type "Desktop app" at
#      https://console.cloud.google.com/apis/credentials, download the JSON, and save it as
#      ~/.config/gws/client_secret.json
#   5. Run: gws auth login -s drive,docs,sheets
#   Note: in "Testing" mode Google expires the sign-in after 7 days; publish the app
#   (Audience > Publish app) for a long-lived sign-in.
#
# Modal (daily cloud schedule)
#   1. Sign up at https://modal.com, then run: python -m modal token new
#   2. Create the secrets the app expects (https://modal.com/secrets):
#        job-agent-env  -> the values from this .env file
#        job-agent-gws  -> GWS_CREDENTIALS_JSON = output of: gws auth export --unmasked
# ---------------------------------------------------------------------------
